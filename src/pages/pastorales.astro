---
import Layout from '../layouts/Layout.astro';
import { parishData } from '../data/parishData';

const categories = [
  { id: 'todos', label: 'Todos los Grupos' },
  { id: 'jovenes', label: 'Jóvenes' },
  { id: 'solidaridad', label: 'Solidaridad y Cáritas' },
  { id: 'liturgia', label: 'Liturgia y Coro' },
  { id: 'formacion', label: 'Catequesis y Formación' },
  { id: 'familia', label: 'Familia y Matrimonios' },
];
---

<Layout 
  title={`Grupos Pastorales | ${parishData.name}`}
  description={`Descubre las áreas pastorales de la ${parishData.name}: Pastoral Juvenil, Cáritas, Catequesis, Coro Litúrgico y Pastoral Familiar. Encuentra cómo sumarte.`}
>
  <!-- Page Banner -->
  <section class="page-banner">
    <div class="container page-banner-inner">
      <span class="badge badge-gold">Comunidad en Acción</span>
      <h1 class="page-banner-title">Grupos Pastorales y Ministerios</h1>
      <p class="page-banner-sub">
        «Hay diversidad de carismas, pero el Espíritu es el mismo» (1 Cor 12, 4). Conoce los diferentes espacios donde compartir la fe, crecer y servir al prójimo.
      </p>
    </div>
  </section>

  <!-- Filter & Ministries Directory -->
  <section class="section section-white">
    <div class="container">
      <!-- Filter Bar -->
      <div class="filters-wrap" role="toolbar" aria-label="Filtrar grupos pastorales">
        {categories.map((cat, idx) => (
          <button 
            class={`filter-btn ${idx === 0 ? 'active' : ''}`}
            data-filter={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Directory Grid -->
      <div class="ministries-directory" id="ministriesList">
        {parishData.ministries.map((ministry) => (
          <article class="ministry-detail-card" data-category={ministry.category} id={ministry.id}>
            <div class="detail-media">
              <img 
                src={ministry.image} 
                alt={ministry.name} 
                loading="lazy" 
                class="detail-img"
              />
              <span class="badge badge-gold category-badge">
                {ministry.categoryLabel}
              </span>
            </div>

            <div class="detail-body">
              <div class="detail-header">
                <h2 class="detail-title">{ministry.name}</h2>
                <p class="detail-short">{ministry.shortDesc}</p>
              </div>

              <div class="detail-description-block">
                <p>{ministry.fullDesc}</p>
              </div>

              <div class="detail-activities-block">
                <h4>Actividades Principales</h4>
                <ul class="activities-list">
                  {ministry.activities.map((act) => (
                    <li>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>{act}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="detail-meta-grid">
                <div class="meta-box">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <div>
                    <strong>Horario y Día</strong>
                    <span>{ministry.schedule}</span>
                  </div>
                </div>

                <div class="meta-box">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <div>
                    <strong>Lugar de Encuentro</strong>
                    <span>{ministry.location}</span>
                  </div>
                </div>

                <div class="meta-box">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                  </svg>
                  <div>
                    <strong>Destinatarios</strong>
                    <span>{ministry.targetAudience}</span>
                  </div>
                </div>

                <div class="meta-box">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                  <div>
                    <strong>Coordinación</strong>
                    <span>{ministry.contactPerson}</span>
                  </div>
                </div>
              </div>

              <div class="detail-actions">
                <a 
                  href={`https://wa.me/${parishData.contact.whatsapp}?text=${encodeURIComponent(`Hola, quisiera más información para sumarme al grupo: ${ministry.name}`)}`} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn btn-whatsapp"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 1.742 1.97 2.08.188.043.332-.014.419-.101.087-.087.375-.434.476-.58.101-.145.202-.116.347-.058s.924.434 1.083.52c.159.087.26.13.299.202.043.072.043.419-.101.824z"/>
                  </svg>
                  <span>Consultar cómo sumarme</span>
                </a>

                <a href="/contacto#formulario-contacto" class="btn btn-secondary">
                  Enviar consulta a secretaría
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       VOCES DE LA PASTORAL JUVENIL
       ======================================== -->
  <section class="section testimonials-section" id="voces-pastoral">
    <div class="testimonials-decor-glow" aria-hidden="true"></div>
    <!-- ========================================================
         FLOATING PORTRAITS CANOPY (Full Bleed Arc with Edge Fading)
         ======================================================== -->
    <div class="canopy-showcase" aria-label="Jóvenes de la Pastoral Juvenil Nueva Vida">
      <!-- Subtle vertical dashed guide lines matching reference image -->
      <div class="canopy-grid-bg" aria-hidden="true">
        <span class="grid-dash-line"></span>
        <span class="grid-dash-line"></span>
        <span class="grid-dash-line"></span>
        <span class="grid-dash-line"></span>
        <span class="grid-dash-line"></span>
        <span class="grid-dash-line"></span>
        <span class="grid-dash-line"></span>
        <span class="grid-dash-line"></span>
        <span class="grid-dash-line"></span>
        <span class="grid-dash-line"></span>
        <span class="grid-dash-line"></span>
        <span class="grid-dash-line"></span>
        <span class="grid-dash-line"></span>
      </div>

      <!-- Animated swaying track with soft gradient edge masks -->
      <div class="canopy-track-outer">
        <div class="canopy-cards-row">
          <!-- Col 1: Far left -->
          <div class="canopy-col canopy-col-1">
            <div class="canopy-card" title="Pastoral Juvenil en comunidad">
              <img src="/images/4.jpeg" alt="Pastoral Juvenil en comunidad" loading="lazy" />
            </div>
            <div class="canopy-card" title="Winifer Ovalle">
              <img src="/images/Winifer.jpeg" alt="Winifer Ovalle" loading="lazy" />
            </div>
          </div>

          <!-- Col 2: Left -->
          <div class="canopy-col canopy-col-2">
            <div class="canopy-card" title="Pastoral Juvenil Nueva Vida">
              <img src="/images/1.jpeg" alt="Pastoral Juvenil Nueva Vida" loading="lazy" />
            </div>
            <div class="canopy-card" title="Angel Junior">
              <img src="/images/Angel Junior.jpeg" alt="Angel Junior" loading="lazy" />
            </div>
          </div>

          <!-- Col 3: Left mid-outer -->
          <div class="canopy-col canopy-col-3">
            <div class="canopy-card" title="Ashley Garcia">
              <img src="/images/Ashley.jpeg" alt="Ashley Garcia" loading="lazy" />
            </div>
            <div class="canopy-card" title="Encuentro de jóvenes">
              <img src="/images/2.jpeg" alt="Encuentro de jóvenes" loading="lazy" />
            </div>
          </div>

          <!-- Col 4: Left inner (tall) -->
          <div class="canopy-col canopy-col-4">
            <div class="canopy-card canopy-card--tall" title="Carlos David">
              <img src="/images/Carlos.jpeg" alt="Carlos David" loading="lazy" />
            </div>
          </div>

          <!-- Col 5: Center left-outer -->
          <div class="canopy-col canopy-col-5">
            <div class="canopy-card" title="Agustín">
              <img src="/images/Agustin.jpeg" alt="Agustín" loading="lazy" />
            </div>
          </div>

          <!-- Col 6: Center apex left -->
          <div class="canopy-col canopy-col-6">
            <div class="canopy-card" title="Pastoral Juvenil Grupo">
              <img src="/images/3.jpeg" alt="Pastoral Juvenil Grupo" loading="lazy" />
            </div>
          </div>

          <!-- Col 7: Center apex right -->
          <div class="canopy-col canopy-col-7">
            <div class="canopy-card" title="Elainne Garcia">
              <img src="/images/Elainne.jpeg" alt="Elainne Garcia" loading="lazy" />
            </div>
          </div>

          <!-- Col 8: Center right-outer -->
          <div class="canopy-col canopy-col-8">
            <div class="canopy-card" title="Keyha">
              <img src="/images/Keyha.jpeg" alt="Keyha" loading="lazy" />
            </div>
          </div>

          <!-- Col 9: Right inner (3D-Tilted) -->
          <div class="canopy-col canopy-col-9">
            <div class="canopy-card canopy-card--tilted" title="Angel">
              <img src="/images/Angel.jpeg" alt="Angel" loading="lazy" />
            </div>
          </div>

          <!-- Col 10: Right mid-outer -->
          <div class="canopy-col canopy-col-10">
            <div class="canopy-card" title="Hamlet Santos">
              <img src="/images/Hamlet.jpeg" alt="Hamlet Santos" loading="lazy" />
            </div>
            <div class="canopy-card" title="Misión en Santiago Oeste">
              <img src="/images/5.jpeg" alt="Misión en Santiago Oeste" loading="lazy" />
            </div>
          </div>

          <!-- Col 11: Right -->
          <div class="canopy-col canopy-col-11">
            <div class="canopy-card" title="Ydalis Caba">
              <img src="/images/Ydalis Caba.jpeg" alt="Ydalis Caba" loading="lazy" />
            </div>
            <div class="canopy-card" title="Angel N">
              <img src="/images/Angel N.jpeg" alt="Angel N" loading="lazy" />
            </div>
          </div>

          <!-- Col 12: Far right -->
          <div class="canopy-col canopy-col-12">
            <div class="canopy-card" title="Yolarfi">
              <img src="/images/Yolarfi.jpeg" alt="Yolarfi" loading="lazy" />
            </div>
            <div class="canopy-card" title="Pastoral Juvenil">
              <img src="/images/1.jpeg" alt="Pastoral Juvenil" loading="lazy" />
            </div>
          </div>
        </div>
      </div>

      <!-- Center content nestled under the rainbow arch -->
      <div class="canopy-center-header">
        <div class="canopy-badge">
          <span class="badge-pulse-dot"></span>
          <span>Testimonios · Pastoral Juvenil «Nueva Vida»</span>
        </div>

        <h2 class="canopy-title">
          Vidas transformadas por la fe<br/>
          <span class="canopy-title-highlight">unidos en Cristo y en comunidad</span>
        </h2>

        <p class="canopy-subtitle">
          Jóvenes de Santiago Oeste comparten cómo la Pastoral Juvenil de la Parroquia San Lorenzo ha llenado sus vidas de paz, amor fraternal y un verdadero propósito.
        </p>
      </div>
    </div><!-- /canopy-showcase -->

    <div class="container relative-z">

      <!-- Divider label -->
      <div class="testimonials-intro">
        <div class="intro-line"></div>
        <span class="intro-label">Sus palabras</span>
        <div class="intro-line"></div>
      </div>

      <!-- Testimonial cards grid -->
      <div class="testimonials-grid">

        <!-- 1. Angel Junior -->
        <article class="testimonial-card featured-pill">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Amor y Acompañamiento</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Angel Junior.jpeg" alt="Foto de Angel Junior" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «Gracias por ser el puente de amor de Dios en nuestras vidas... Cuando el camino se ponía difícil, Dios ya había puesto sus manos entre nosotros.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Angel Junior</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 2. Winifer Ovalle -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Crecimiento Humano</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Winifer.jpeg" alt="Foto de Winifer Ovalle" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «Me ha enseñado a ser mejor persona y a ayudar a los demás con mayor firmeza y comprensión.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Winifer Ovalle</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 3. Angel -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Transformación</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Angel.jpeg" alt="Foto de Angel" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «Marcó un cambio notable e integral en mi vida personal.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Angel</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 4. Carlos David -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Paz Interior</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Carlos.jpeg" alt="Foto de Carlos David" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «La pastoral me ha regalado una paz profunda y verdadera.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Carlos David</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 5. Elainne Garcia -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Gratitud</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Elainne.jpeg" alt="Foto de Elainne Garcia" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «Gratificante: así ha sido el modo en que la Pastoral transformó mi vida por completo.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Elainne Garcia</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 6. Ashley Garcia -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Comunidad y Fe</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Ashley.jpeg" alt="Foto de Ashley Garcia" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «Cambió mi forma de ver el mundo y me rodeó de personas de las que aprendo cada día mientras nos acercamos a Cristo.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Ashley Garcia</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 7. Hamlet Santos -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Amor y Paz</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Hamlet.jpeg" alt="Foto de Hamlet Santos" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «En una sola frase: más amor y más paz en mi corazón.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Hamlet Santos</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 8. Agustín -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Encuentro con Dios</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Agustin.jpeg" alt="Foto de Agustín" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «La pastoral me acercó a Dios de una manera que no esperaba, y encontré en ella mi lugar en la comunidad.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Agustín</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 9. Angel N -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Propósito de Vida</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Angel N.jpeg" alt="Foto de Angel N" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «Aquí descubrí un propósito más grande que yo mismo: servir a los demás con el corazón puesto en Cristo.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Angel N</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 10. Keyha -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Alegría del Evangelio</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Keyha.jpeg" alt="Foto de Keyha" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «La pastoral me enseñó a sonreírle al mundo desde la fe; cada encuentro es una razón para agradecer.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Keyha</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>

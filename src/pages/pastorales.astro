---
import Layout from '../layouts/Layout.astro';
import { parishData } from '../data/parishData';

const categories = [
  { id: 'todos', label: 'Todos los Grupos' },
  { id: 'jovenes', label: 'Jóvenes' },
  { id: 'solidaridad', label: 'Solidaridad y Cáritas' },
  { id: 'liturgia', label: 'Liturgia y Coro' },
  { id: 'formacion', label: 'Catequesis y Formación' },
  { id: 'familia', label: 'Familia y Matrimonios' },
];
---

<Layout 
  title={`Grupos Pastorales | ${parishData.name}`}
  description={`Descubre las áreas pastorales de la ${parishData.name}: Pastoral Juvenil, Cáritas, Catequesis, Coro Litúrgico y Pastoral Familiar. Encuentra cómo sumarte.`}
>
  <!-- Page Banner -->
  <section class="page-banner">
    <div class="container page-banner-inner">
      <span class="badge badge-gold">Comunidad en Acción</span>
      <h1 class="page-banner-title">Grupos Pastorales y Ministerios</h1>
      <p class="page-banner-sub">
        «Hay diversidad de carismas, pero el Espíritu es el mismo» (1 Cor 12, 4). Conoce los diferentes espacios donde compartir la fe, crecer y servir al prójimo.
      </p>
    </div>
  </section>

  <!-- Filter & Ministries Directory -->
  <section class="section section-white">
    <div class="container">
      <!-- Filter Bar -->
      <div class="filters-wrap" role="toolbar" aria-label="Filtrar grupos pastorales">
        {categories.map((cat, idx) => (
          <button 
            class={`filter-btn ${idx === 0 ? 'active' : ''}`}
            data-filter={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Directory Grid -->
      <div class="ministries-directory" id="ministriesList">
        {parishData.ministries.map((ministry) => (
          <article class="ministry-detail-card" data-category={ministry.category} id={ministry.id}>
            <div class="detail-media">
              <img 
                src={ministry.image} 
                alt={ministry.name} 
                loading="lazy" 
                class="detail-img"
              />
              <span class="badge badge-gold category-badge">
                {ministry.categoryLabel}
              </span>
            </div>

            <div class="detail-body">
              <div class="detail-header">
                <h2 class="detail-title">{ministry.name}</h2>
                <p class="detail-short">{ministry.shortDesc}</p>
              </div>

              <div class="detail-description-block">
                <p>{ministry.fullDesc}</p>
              </div>

              <div class="detail-activities-block">
                <h4>Actividades Principales</h4>
                <ul class="activities-list">
                  {ministry.activities.map((act) => (
                    <li>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>{act}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="detail-meta-grid">
                <div class="meta-box">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <div>
                    <strong>Horario y Día</strong>
                    <span>{ministry.schedule}</span>
                  </div>
                </div>

                <div class="meta-box">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <div>
                    <strong>Lugar de Encuentro</strong>
                    <span>{ministry.location}</span>
                  </div>
                </div>

                <div class="meta-box">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                  </svg>
                  <div>
                    <strong>Destinatarios</strong>
                    <span>{ministry.targetAudience}</span>
                  </div>
                </div>

                <div class="meta-box">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                  <div>
                    <strong>Coordinación</strong>
                    <span>{ministry.contactPerson}</span>
                  </div>
                </div>
              </div>

              <div class="detail-actions">
                <a 
                  href={`https://wa.me/${parishData.contact.whatsapp}?text=${encodeURIComponent(`Hola, quisiera más información para sumarme al grupo: ${ministry.name}`)}`} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn btn-whatsapp"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 1.742 1.97 2.08.188.043.332-.014.419-.101.087-.087.375-.434.476-.58.101-.145.202-.116.347-.058s.924.434 1.083.52c.159.087.26.13.299.202.043.072.043.419-.101.824z"/>
                  </svg>
                  <span>Consultar cómo sumarme</span>
                </a>

                <a href="/contacto#formulario-contacto" class="btn btn-secondary">
                  Enviar consulta a secretaría
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       VOCES DE LA PASTORAL JUVENIL
       ======================================== -->
  <section class="section testimonials-section" id="voces-pastoral">
    <div class="testimonials-decor-glow" aria-hidden="true"></div>
    <div class="container relative-z">

      <!-- Section Header -->
      <div class="testimonials-header">
        <div class="testimonials-badge">
          <div class="avatar-stack">
            <img src="/images/Angel Junior.jpeg" alt="Angel Junior" class="avatar-stack-item" />
            <img src="/images/Winifer.jpeg" alt="Winifer Ovalle" class="avatar-stack-item" />
            <img src="/images/Carlos.jpeg" alt="Carlos David" class="avatar-stack-item" />
            <img src="/images/Elainne.jpeg" alt="Elainne Garcia" class="avatar-stack-item" />
            <img src="/images/Ashley.jpeg" alt="Ashley Garcia" class="avatar-stack-item" />
            <span class="avatar-stack-count">+12</span>
          </div>
          <span class="badge-text">Testimonios · Pastoral Juvenil «Nueva Vida»</span>
        </div>

        <h2 class="testimonials-title">
          Vidas transformadas por la fe<br/>
          <span class="testimonials-title-highlight">unidos en Cristo y en comunidad</span>
        </h2>

        <p class="testimonials-subtitle">
          Jóvenes de Santiago Oeste comparten cómo la Pastoral Juvenil de la Parroquia San Lorenzo ha llenado sus vidas de paz, amor fraternal y un verdadero propósito.
        </p>
      </div>

      <!-- Divider label -->
      <div class="testimonials-intro">
        <div class="intro-line"></div>
        <span class="intro-label">Sus palabras</span>
        <div class="intro-line"></div>
      </div>

      <!-- Testimonial cards grid -->
      <div class="testimonials-grid">

        <!-- 1. Angel Junior -->
        <article class="testimonial-card featured-pill">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Amor y Acompañamiento</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Angel Junior.jpeg" alt="Foto de Angel Junior" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «Gracias por ser el puente de amor de Dios en nuestras vidas... Cuando el camino se ponía difícil, Dios ya había puesto sus manos entre nosotros.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Angel Junior</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 2. Winifer Ovalle -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Crecimiento Humano</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Winifer.jpeg" alt="Foto de Winifer Ovalle" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «Me ha enseñado a ser mejor persona y a ayudar a los demás con mayor firmeza y comprensión.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Winifer Ovalle</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 3. Angel -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Transformación</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Angel.jpeg" alt="Foto de Angel" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «Marcó un cambio notable e integral en mi vida personal.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Angel</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 4. Carlos David -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Paz Interior</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Carlos.jpeg" alt="Foto de Carlos David" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «La pastoral me ha regalado una paz profunda y verdadera.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Carlos David</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 5. Elainne Garcia -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Gratitud</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Elainne.jpeg" alt="Foto de Elainne Garcia" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «Gratificante: así ha sido el modo en que la Pastoral transformó mi vida por completo.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Elainne Garcia</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 6. Ashley Garcia -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Comunidad y Fe</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Ashley.jpeg" alt="Foto de Ashley Garcia" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «Cambió mi forma de ver el mundo y me rodeó de personas de las que aprendo cada día mientras nos acercamos a Cristo.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Ashley Garcia</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 7. Hamlet Santos -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Amor y Paz</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Hamlet.jpeg" alt="Foto de Hamlet Santos" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «En una sola frase: más amor y más paz en mi corazón.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Hamlet Santos</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 8. Agustín -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Encuentro con Dios</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Agustin.jpeg" alt="Foto de Agustín" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «La pastoral me acercó a Dios de una manera que no esperaba, y encontré en ella mi lugar en la comunidad.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Agustín</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 9. Angel N -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Propósito de Vida</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Angel N.jpeg" alt="Foto de Angel N" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «Aquí descubrí un propósito más grande que yo mismo: servir a los demás con el corazón puesto en Cristo.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Angel N</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 10. Keyha -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Alegría del Evangelio</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Keyha.jpeg" alt="Foto de Keyha" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «La pastoral me enseñó a sonreírle al mundo desde la fe; cada encuentro es una razón para agradecer.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Keyha</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 11. Ydalis Caba -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Esperanza Renovada</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Ydalis Caba.jpeg" alt="Foto de Ydalis Caba" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «La Pastoral Juvenil renovó mi esperanza y me dio la certeza de que nunca caminamos solos.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Ydalis Caba</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

        <!-- 12. Yolarfi -->
        <article class="testimonial-card">
          <div class="testimonial-card-top">
            <span class="testimonial-chip">Servicio y Amor</span>
          </div>
          <div class="testimonial-photo-wrap">
            <img src="/images/Yolarfi.jpeg" alt="Foto de Yolarfi" class="testimonial-photo" loading="lazy" />
          </div>
          <div class="testimonial-body">
            <div class="quote-mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="testimonial-quote">
              «Aprendí que servir es la forma más bella de amar, y la pastoral me puso en ese camino para siempre.»
            </blockquote>
            <div class="testimonial-author">
              <h3 class="testimonial-name">Yolarfi</h3>
              <span class="testimonial-tag">Pastoral Juvenil</span>
            </div>
          </div>
        </article>

      </div><!-- /testimonials-grid -->

      <!-- ========================================================
           PASTORAL JUVENIL «NUEVA VIDA» - MOMENTOS (Fotos 1 a 5)
           ======================================================== -->
      <div class="pastoral-moments-showcase" aria-label="Momentos de Pastoral Juvenil Nueva Vida">
        <div class="moments-header">
          <span class="moments-pill">Vida en Fraternidad</span>
          <h3 class="moments-title">Momentos de la Pastoral Juvenil «Nueva Vida»</h3>
          <p class="moments-sub">
            Encuentros, retiros y dinámicas comunitarias donde compartimos la alegría del Evangelio en la Parroquia San Lorenzo.
          </p>
        </div>

        <div class="moments-grid">
          <div class="moment-card moment-card--hero">
            <img src="/images/1.jpeg" alt="Pastoral Juvenil Nueva Vida compartiendo en comunidad" loading="lazy" />
            <div class="moment-overlay">
              <span class="moment-badge">Encuentro Comunitario</span>
              <span class="moment-caption">Caminando juntos en la fe y la amistad</span>
            </div>
          </div>
          <div class="moment-card">
            <img src="/images/2.jpeg" alt="Jóvenes de San Lorenzo reunidos en alegría" loading="lazy" />
            <div class="moment-overlay">
              <span class="moment-caption">Unidad y oración en Cristo</span>
            </div>
          </div>
          <div class="moment-card">
            <img src="/images/3.jpeg" alt="Reflexión bíblica y dinámicas juveniles" loading="lazy" />
            <div class="moment-overlay">
              <span class="moment-caption">Dinámicas y fraternidad viva</span>
            </div>
          </div>
          <div class="moment-card">
            <img src="/images/4.jpeg" alt="Encuentro en el salón parroquial" loading="lazy" />
            <div class="moment-overlay">
              <span class="moment-caption">Formación y compromiso</span>
            </div>
          </div>
          <div class="moment-card">
            <img src="/images/5.jpeg" alt="Misión juvenil en Santiago Oeste" loading="lazy" />
            <div class="moment-overlay">
              <span class="moment-caption">Sembrando esperanza en Cienfuegos</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ========================================================
           GRANDES EVENTOS DE NUESTRA PASTORAL JUVENIL
           ======================================================== -->
      <div class="pastoral-events-showcase" aria-label="Grandes Eventos de la Pastoral Juvenil">
        <div class="events-showcase-header">
          <span class="moments-pill">Historia y Fraternidad</span>
          <h3 class="events-showcase-title">Grandes Eventos de Nuestra Pastoral</h3>
          <p class="events-showcase-sub">
            Revive las experiencias inolvidables que marcan el corazón de nuestra juventud: campamentos de fe, expresiones folclóricas, senderismo ecológico y fiestas comunitarias.
          </p>
        </div>

        <div class="events-cards-grid">
          <!-- 1. Campamento Enciéndete 2025 -->
          <article class="p-event-card">
            <div class="p-event-media">
              <img src="/images/35.jpeg" alt="Campamento Enciéndete 2025" loading="lazy" />
              <div class="p-event-badges">
                <span class="badge badge-gold">Campamento 2025</span>
                <span class="badge badge-dark">15 Fotos</span>
              </div>
            </div>
            <div class="p-event-content">
              <h4 class="p-event-title">Campamento Enciéndete 2025</h4>
              <p class="p-event-desc">
                Días de renovación espiritual, adoración eucarística con el Santísimo, dinámicas de liderazgo en equipo y la entrega de reconocimientos en un ambiente de profunda hermandad juvenil.
              </p>
              <div class="p-event-preview-strip">
                <img src="/images/25.jpeg" alt="Adoración Eucarística" title="Adoración Eucarística" />
                <img src="/images/30.jpeg" alt="Oración Matutina" title="Oración Matutina" />
                <img src="/images/34.jpeg" alt="Dinámica Campestre" title="Dinámica Campestre" />
                <img src="/images/38.jpeg" alt="Juegos de Campamento" title="Juegos de Campamento" />
              </div>
              <a href="/experiencias#campamento-enciendete-2025" class="p-event-link">
                <span>Ver álbum completo (15 fotos)</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
            </div>
          </article>

          <!-- 2. Senderismo 2026 -->
          <article class="p-event-card">
            <div class="p-event-media">
              <img src="/images/61.jpeg" alt="Senderismo Juvenil 2026" loading="lazy" />
              <div class="p-event-badges">
                <span class="badge badge-gold">Senderismo 2026</span>
                <span class="badge badge-dark">9 Fotos</span>
              </div>
            </div>
            <div class="p-event-content">
              <h4 class="p-event-title">Senderismo Juvenil 2026</h4>
              <p class="p-event-desc">
                Caminata y convivencia en las montañas de nuestra tierra. Un encuentro con la creación divina, ejercicio saludable y fraternidad en las alturas con vistas panorámicas inolvidables.
              </p>
              <div class="p-event-preview-strip">
                <img src="/images/53.jpeg" alt="Sendero de montaña" title="Sendero de montaña" />
                <img src="/images/55.jpeg" alt="Paseo a caballo" title="Paseo a caballo" />
                <img src="/images/58.jpeg" alt="Mirador hacia el valle" title="Mirador hacia el valle" />

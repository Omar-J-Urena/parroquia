---
import Layout from '../layouts/Layout.astro';
import { parishData } from '../data/parishData';

const categories = ['Todas', 'Celebración Litúrgica', 'Acción Social', 'Pastoral Juvenil', 'Arte y Liturgia', 'Sacramentos'];
---

<Layout 
  title={`Experiencias y Galería | ${parishData.name}`}
  description={`Revive los momentos más significativos de nuestra comunidad: fiestas patronales, misiones de Cáritas, retiros juveniles y celebraciones sacramentales.`}
>
  <!-- Page Banner -->
  <section class="page-banner">
    <div class="container page-banner-inner">
      <span class="badge badge-gold">Memoria y Vida Comunitaria</span>
      <h1 class="page-banner-title">Experiencias y Galería</h1>
      <p class="page-banner-sub">
        Fotografías y testimonios que dan testimonio vivo de la gracia de Dios actuando en nuestra comunidad parroquial a lo largo del año.
      </p>
    </div>
  </section>

  <!-- Gallery Main Section -->
  <section class="section section-white">
    <div class="container">
      <!-- Category Filter Pills -->
      <div class="gallery-filters" role="toolbar" aria-label="Filtrar por categoría">
        {categories.map((cat, idx) => (
          <button 
            class={`gal-filter-btn ${idx === 0 ? 'active' : ''}`}
            data-cat={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Experience Cards Grid -->
      <div class="experiences-grid" id="experiencesGrid">
        {parishData.experiences.map((exp) => (
          <article class="exp-full-card" data-category={exp.category} id={exp.id}>
            <div class="exp-img-box">
              <img 
                src={exp.image} 
                alt={exp.title} 
                class="lightbox-trigger exp-main-img" 
                loading="lazy"
                data-full={exp.image}
                data-caption={exp.title}
              />
              <div class="img-badge-overlay">
                <span class="badge badge-gold">{exp.category}</span>
                <span class="badge badge-dark">{exp.date}</span>
              </div>
              <button class="zoom-btn" title="Ampliar imagen" aria-label={`Ampliar imagen de ${exp.title}`} data-img={exp.image} data-caption={exp.title}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
              </button>
            </div>

            <div class="exp-card-info">
              {exp.relatedMinistry && (
                <span class="exp-ministry-badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  {exp.relatedMinistry}
                </span>
              )}

              <h2 class="exp-card-title">{exp.title}</h2>
              <p class="exp-card-desc">{exp.description}</p>

              {exp.gallery && exp.gallery.length > 1 && (
                <div class="exp-thumbs">
                  <span class="thumbs-label">Más fotos de este evento:</span>
                  <div class="thumbs-row">
                    {exp.gallery.map((thumb, tIdx) => (
                      <button 
                        class="thumb-btn" 
                        data-img={thumb} 
                        data-caption={`${exp.title} - Foto ${tIdx + 1}`}
                        aria-label={`Ver foto ${tIdx + 1}`}
                      >
                        <img src={thumb} alt="" loading="lazy" />
                      </button>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Video and Multimedia Section -->
  <section class="section section-warm video-section">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Audiovisual y Redes</span>
        <h2 class="section-title">Nuestras Celebraciones en Video</h2>
        <div class="ornament-divider">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v20M5 8h14"/>
          </svg>
        </div>
        <p class="section-description">
          Sigue las transmisiones y resúmenes de nuestras celebraciones solemnes y actividades parroquiales en nuestro canal de YouTube.
        </p>
      </div>

      <div class="video-container-card">
        <div class="video-placeholder-frame">
          <img src="/images/interior-mass.jpg" alt="Transmisión Santa Misa" class="video-preview-img" />
          <div class="video-overlay-tint">
            <a 
              href={parishData.social.youtube} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="video-play-btn"
              aria-label="Ver canal de YouTube de la parroquia"
            >
              <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </a>
            <div class="video-meta-text">
              <h3>Canal Oficial de YouTube • {parishData.name}</h3>
              <p>Misas transmitidas en vivo para enfermos y ancianos impedidos de asistir físicamente.</p>
              <span class="video-disclaimer">* Los videos no se reproducen automáticamente con sonido para cuidar tu navegación.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Media Permissions & Privacy Policy Note -->
  <section class="section section-white privacy-note-section">
    <div class="container container-narrow">
      <div class="privacy-card">
        <div class="privacy-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <div class="privacy-content">
          <h4>Cuidado de la Privacidad y Permisos de Imagen</h4>
          <p>
            En cumplimiento de las normativas de protección de datos y el respeto a la intimidad de nuestros feligreses y menores de edad, las fotografías publicadas en este portal cuentan con la autorización correspondiente para fines pastorales e informativos de la parroquia. Si deseas solicitar la remoción de alguna fotografía en la que aparezcas tú o tus hijos, por favor contáctanos a través de nuestro <a href="/contacto">despacho parroquial</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox Modal Component -->
  <div id="lightboxModal" class="lightbox-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Visor de imagen">
    <div class="lightbox-content">
      <button id="closeLightbox" class="lightbox-close" aria-label="Cerrar visor">✕</button>
      <img id="lightboxImg" src="" alt="" class="lightbox-full-img" />
      <p id="lightboxCaption" class="lightbox-caption"></p>
    </div>
  </div>
</Layout>

<style>
  /* Banner */
  .page-banner {
    background: linear-gradient(135deg, var(--color-burgundy-dark), var(--color-burgundy));
    color: #FFFFFF;
    padding: 5rem 0 4.5rem;
    text-align: center;
    position: relative;
  }

  .page-banner-inner {
    max-width: 780px;
  }

  .page-banner-title {
    color: #FFFFFF;
    font-size: clamp(2.3rem, 4vw, 3.4rem);
    margin: 1rem 0 1.2rem;
  }

  .page-banner-sub {
    color: #F2E9E3;
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Filters */
  .gallery-filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 3.5rem;
  }

  .gal-filter-btn {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .gal-filter-btn:hover {
    border-color: var(--color-burgundy);
    color: var(--color-burgundy);
  }

  .gal-filter-btn.active {
    background: var(--color-burgundy);
    color: #FFFFFF;
    border-color: var(--color-burgundy);
    box-shadow: 0 4px 12px var(--color-burgundy-glow);
  }

  /* Grid */
  .experiences-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 2.5rem;
  }

  .exp-full-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: var(--transition-smooth);
  }

  .exp-full-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(197, 160, 89, 0.45);
  }

  .exp-img-box {
    position: relative;
    height: 280px;
    overflow: hidden;
    cursor: pointer;
  }

  .exp-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .exp-full-card:hover .exp-main-img {
    transform: scale(1.05);
  }

  .img-badge-overlay {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    gap: 0.5rem;
    z-index: 2;
  }

  .badge-dark {
    background: rgba(28, 20, 24, 0.85);
    color: #FAF5EE;
    backdrop-filter: blur(4px);
  }

  .zoom-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.9);
    border: none;
    color: var(--color-burgundy);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    transition: var(--transition-smooth);
    z-index: 2;
  }

  .zoom-btn:hover {
    background: var(--color-burgundy);
    color: #FFFFFF;
    transform: scale(1.1);
  }

  .exp-card-info {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.85rem;
  }

  .exp-ministry-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-burgundy);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .exp-card-title {
    font-size: 1.45rem;
    color: var(--color-burgundy-dark);
    margin: 0;
    line-height: 1.3;
  }

  .exp-card-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .exp-thumbs {
    margin-top: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .thumbs-label {
    display: block;
    font-size: 0.78rem;
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .thumbs-row {
    display: flex;
    gap: 0.5rem;
  }

  .thumb-btn {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    padding: 0;
    transition: var(--transition-smooth);
  }

  .thumb-btn:hover {
    border-color: var(--color-gold);
    transform: scale(1.05);
  }

  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Video frame */
  .video-container-card {
    max-width: 900px;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-border);
  }

  .video-placeholder-frame {
    position: relative;
    height: 440px;
  }

  .video-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-overlay-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 32, 28, 0.95), rgba(78, 21, 36, 0.7));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2.5rem;
    color: #FFFFFF;
  }

  .video-play-btn {
    width: 76px;
    height: 76px;
    border-radius: var(--radius-full);
    background: #FF0000;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(255, 0, 0, 0.4);
    transition: var(--transition-smooth);
    margin-bottom: 1.5rem;
  }

  .video-play-btn:hover {
    transform: scale(1.12);
    box-shadow: 0 12px 32px rgba(255, 0, 0, 0.6);
  }

  .video-meta-text h3 {
    color: #FFFFFF;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .video-meta-text p {
    color: #E6DFDA;
    max-width: 600px;
    margin: 0 auto 0.75rem;
    font-size: 1.05rem;
  }

  .video-disclaimer {
    font-size: 0.8rem;
    color: var(--color-gold-light);
  }

  /* Privacy Notice */
  .privacy-card {
    background: var(--color-ivory-warm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .privacy-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: #FFFFFF;
    color: var(--color-green);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }

  .privacy-content h4 {
    color: var(--color-green);
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .privacy-content p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Lightbox */
  .lightbox-modal {
    position: fixed;
    inset: 0;
    background: rgba(18, 14, 16, 0.92);
    backdrop-filter: blur(8px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .lightbox-modal.open {
    display: flex;
  }

  .lightbox-content {
    position: relative;
    max-width: 960px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox-close {
    position: absolute;
    top: -45px;
    right: 0;
    background: none;
    border: none;
    color: #FFFFFF;
    font-size: 1.8rem;
    cursor: pointer;
    padding: 0.5rem;
  }

  .lightbox-full-img {
    max-width: 100%;
    max-height: 80vh;
    border-radius: var(--radius-md);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    object-fit: contain;
  }

  .lightbox-caption {
    color: #FFFFFF;
    margin-top: 1rem;
    font-size: 1.05rem;
    font-family: var(--font-serif);
    text-align: center;
  }

  @media (max-width: 768px) {
    .experiences-grid {
      grid-template-columns: 1fr;
    }
    .video-placeholder-frame {
      height: 320px;
    }
  }
</style>

<script>
  // Filter logic
  const filterBtns = document.querySelectorAll('.gal-filter-btn');
  const expCards = document.querySelectorAll('.exp-full-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-cat');
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      expCards.forEach((c) => {
        const itemCat = c.getAttribute('data-category');
        if (cat === 'Todas' || itemCat === cat) {
          (c as HTMLElement).style.display = 'flex';
        } else {
          (c as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Lightbox modal logic
  const modal = document.getElementById('lightboxModal');
  const modalImg = document.getElementById('lightboxImg') as HTMLImageElement;
  const modalCaption = document.getElementById('lightboxCaption');
  const closeBtn = document.getElementById('closeLightbox');

  const openLightbox = (src: string, caption: string) => {
    if (modal && modalImg && modalCaption) {
      modalImg.src = src;
      modalCaption.textContent = caption;
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  };

  const closeLightbox = () => {
    if (modal) {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  };

  // Triggers
  document.querySelectorAll('.zoom-btn, .thumb-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const img = btn.getAttribute('data-img');
      const caption = btn.getAttribute('data-caption') || '';
      if (img) openLightbox(img, caption);
    });
  });

  document.querySelectorAll('.lightbox-trigger').forEach((imgEl) => {
    imgEl.addEventListener('click', () => {
      const full = imgEl.getAttribute('data-full');
      const caption = imgEl.getAttribute('data-caption') || '';
      if (full) openLightbox(full, caption);
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeLightbox();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('open')) {
      closeLightbox();
    }
  });
</script>

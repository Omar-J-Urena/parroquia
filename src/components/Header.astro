---
import { parishData } from '../data/parishData';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/nuestra-parroquia', label: 'Nuestra Parroquia' },
  { href: '/pastorales', label: 'Grupos Pastorales' },
  { href: '/experiencias', label: 'Experiencias' },
  { href: '/contacto', label: 'Visítanos y Contacto' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
};
---

<!-- Top utility bar -->
<div class="top-bar" role="banner">
  <div class="container top-bar-inner">
    <div class="top-bar-left">
      <!-- Mass times chip -->
      <span class="top-bar-chip">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        <strong>Misas:</strong>
        <span>Lun–Vie 7:00 am y 6:30 pm</span>
        <span class="chip-divider">·</span>
        <span>Dom 8:00 am, 10:00 am y 6:30 pm</span>
      </span>

      <!-- Address chip (hidden on small screens) -->
      <span class="top-bar-chip hide-tablet">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
        <span>{parishData.address.street}, {parishData.address.neighborhood}</span>
      </span>
    </div>

    <div class="top-bar-right">
      <!-- WhatsApp button -->
      <a
        href={`https://wa.me/${parishData.contact.whatsapp}?text=${encodeURIComponent(parishData.contact.whatsappMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="top-wa-btn"
        title="Contactar por WhatsApp"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 1.742 1.97 2.08.188.043.332-.014.419-.101.087-.087.375-.434.476-.58.101-.145.202-.116.347-.058s.924.434 1.083.52c.159.087.26.13.299.202.043.072.043.419-.101.824z"/>
        </svg>
        <span>WhatsApp Parroquial</span>
      </a>

      <!-- Phone number (hidden on mobile) -->
      <a href={`tel:${parishData.contact.phone}`} class="top-phone hide-mobile">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.21 11.9 19.79 19.79 0 0 1 1.14 3.27 2 2 0 0 1 3.11 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81A2 2 0 0 1 8.36 7.6L7.08 8.88a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21 16z"/>
        </svg>
        <span>{parishData.contact.phoneDisplay}</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="site-header" id="mainHeader">
  <div class="container header-inner">
    <!-- Brand / Logo -->
    <a href="/" class="brand-link" aria-label={`Página principal de ${parishData.name}`}>
      <div class="brand-icon-wrap">
        <img src="/images/parish-crest.svg" alt="Cruz de la Parroquia San Lorenzo" class="brand-crest" width="44" height="44" />
      </div>
      <div class="brand-text">
        <span class="brand-title">{parishData.name}</span>
        <span class="brand-subtitle">{parishData.diocese}</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li class="nav-item">
            <a
              href={item.href}
              class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header CTA & Mobile Toggle -->
    <div class="header-actions">
      <a href="/contacto#horarios" class="btn btn-primary btn-sm header-cta">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        <span>Horarios de Misa</span>
      </a>

      <!-- Mobile Hamburger -->
      <button
        id="mobileMenuToggle"
        class="mobile-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobileDrawer"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer -->
<div id="mobileDrawer" class="mobile-drawer" aria-hidden="true">
  <div class="drawer-header">
    <div class="drawer-brand">
      <img src="/images/parish-crest.svg" alt="Escudo Parroquial" width="34" height="34" />
      <div>
        <span class="drawer-title">{parishData.name}</span>
        <span class="drawer-subtitle">{parishData.diocese}</span>
      </div>
    </div>
    <button id="closeDrawerBtn" class="close-drawer" aria-label="Cerrar menú">✕</button>
  </div>

  <nav class="mobile-nav" aria-label="Navegación móvil">
    <ul class="mobile-nav-list">
      {navItems.map((item) => (
        <li class="mobile-nav-item">
          <a
            href={item.href}
            class={`mobile-nav-link ${isActive(item.href) ? 'active' : ''}`}
          >
            <span>{item.label}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="drawer-contact">
    <div class="drawer-contact-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
      </svg>
      <span>{parishData.address.street}</span>
    </div>
    <div class="drawer-contact-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 3.27 3.28 2 2 0 0 1 5.24 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L9.22 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 23 16z"/>
      </svg>
      <a href={`tel:${parishData.contact.phone}`}>{parishData.contact.phoneDisplay}</a>
    </div>
  </div>

  <div class="drawer-footer">
    <a href="/contacto#horarios" class="btn btn-primary btn-block">
      Ver Horarios de Misa
    </a>
    <a
      href={`https://wa.me/${parishData.contact.whatsapp}?text=${encodeURIComponent(parishData.contact.whatsappMessage)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-whatsapp btn-block"
    >
      Escribir por WhatsApp
    </a>
  </div>
</div>
<div id="drawerBackdrop" class="drawer-backdrop" aria-hidden="true"></div>

<style>
  /* ─── TOP BAR ───────────────────────────────────────── */
  .top-bar {
    background: var(--color-burgundy-dark);
    color: rgba(255,255,255,0.88);
    font-size: 0.8rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(197,160,89,0.3);
  }

  .top-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: nowrap;
  }

  .top-bar-left,
  .top-bar-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Chip-style info pills */
  .top-bar-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 99px;
    padding: 0.22rem 0.75rem;
    white-space: nowrap;
    line-height: 1.4;
  }

  .top-bar-chip svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .top-bar-chip strong {
    color: var(--color-gold);
    font-weight: 700;
    margin-right: 0.1rem;
  }

  .chip-divider {
    color: rgba(255,255,255,0.3);
    margin: 0 0.1rem;
  }

  /* WhatsApp button in top bar */
  .top-wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(34,197,94,0.15);
    border: 1px solid rgba(74,222,128,0.35);
    border-radius: 99px;
    padding: 0.22rem 0.75rem;
    color: #4ade80 !important;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
  }

  .top-wa-btn:hover {
    background: rgba(34,197,94,0.28);
    color: #86efac !important;
  }

  /* Phone link in top bar */
  .top-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: rgba(255,255,255,0.82) !important;
    text-decoration: none;
    border-left: 1px solid rgba(255,255,255,0.15);
    padding-left: 0.65rem;
    margin-left: 0.1rem;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .top-phone:hover { color: #fff !important; }
  .top-phone svg { color: var(--color-gold); }

  /* ─── MAIN HEADER ────────────────────────────────────── */
  .site-header {
    background: rgba(250, 247, 242, 0.97);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: box-shadow 0.3s;
  }

  .site-header.scrolled {
    box-shadow: 0 2px 20px rgba(0,0,0,0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 1.5rem;
  }

  /* Brand */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-burgundy);
    box-shadow: 0 2px 10px rgba(114,34,55,0.25);
    transition: transform 0.3s, box-shadow 0.3s;
    flex-shrink: 0;
  }

  .brand-link:hover .brand-icon-wrap {
    transform: scale(1.06);
    box-shadow: 0 4px 16px rgba(114,34,55,0.35);
  }

  .brand-crest {
    width: 38px;
    height: 38px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-title {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--color-burgundy-dark);
    white-space: nowrap;
  }

  .brand-subtitle {
    font-size: 0.68rem;
    color: var(--color-gold-dark);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* Desktop Nav */
  .desktop-nav { display: block; }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: block;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text-main);
    padding: 0.5rem 0.65rem;
    border-radius: var(--radius-sm);
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 0.65rem;
    right: 0.65rem;
    height: 2px;
    background: linear-gradient(to right, var(--color-burgundy), var(--color-gold));
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .nav-link:hover {
    color: var(--color-burgundy);
    background: rgba(114,34,55,0.05);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link.active {
    color: var(--color-burgundy);
    font-weight: 600;
  }

  /* CTA & Mobile Toggle */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 38px;
    height: 38px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 8px 7px;
    cursor: pointer;
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 2px;
    background: var(--color-burgundy);
    border-radius: 2px;
    transition: 0.3s;
  }

  /* ─── MOBILE DRAWER ──────────────────────────────────── */
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: -320px;
    width: 300px;
    height: 100vh;
    background: #FFFAF5;
    box-shadow: -4px 0 30px rgba(0,0,0,0.15);
    z-index: 200;
    display: flex;
    flex-direction: column;
    transition: right 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
  }

  .mobile-drawer.open { right: 0; }

  .drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    backdrop-filter: blur(4px);
    z-index: 150;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .drawer-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.25rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-burgundy-dark);
  }

  .drawer-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .drawer-brand img {
    border-radius: 50%;
  }

  .drawer-title {
    display: block;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.92rem;
    color: #fff;
    line-height: 1.2;
  }

  .drawer-subtitle {
    display: block;
    font-size: 0.65rem;
    color: rgba(255,255,255,0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .close-drawer {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    cursor: pointer;
    color: #fff;
    transition: background 0.2s;
  }

  .close-drawer:hover { background: rgba(255,255,255,0.22); }

  .mobile-nav { padding: 0.75rem 1rem; }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 0.9rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-text-main);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    background: rgba(114,34,55,0.07);
    color: var(--color-burgundy);
    font-weight: 600;
  }

  .mobile-nav-link svg { opacity: 0.45; }

  /* Contact info strip inside drawer */
  .drawer-contact {
    margin: 0 1rem;
    padding: 0.9rem 1rem;
    background: rgba(114,34,55,0.05);
    border: 1px solid rgba(114,34,55,0.1);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .drawer-contact-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .drawer-contact-item svg { color: var(--color-burgundy); flex-shrink: 0; }
  .drawer-contact-item a { color: var(--color-burgundy); font-weight: 600; text-decoration: none; }

  .drawer-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .btn-block {
    width: 100%;
    text-align: center;
    justify-content: center;
  }

  /* ─── RESPONSIVE ─────────────────────────────────────── */
  @media (max-width: 1024px) {
    .desktop-nav { display: none; }
    .mobile-toggle { display: flex; }
    .hide-tablet { display: none !important; }
  }

  @media (max-width: 680px) {
    .hide-mobile { display: none !important; }
    .header-cta { display: none; }
    .brand-subtitle { display: none; }
  }

  @media (max-width: 400px) {
    .brand-title { font-size: 0.95rem; }
  }
</style>

<script>
  // Scroll shadow
  const header = document.getElementById('mainHeader');
  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('scrolled', window.scrollY > 12);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile drawer controls
  const toggleBtn = document.getElementById('mobileMenuToggle');
  const closeBtn  = document.getElementById('closeDrawerBtn');
  const drawer    = document.getElementById('mobileDrawer');
  const backdrop  = document.getElementById('drawerBackdrop');

  const openDrawer = () => {
    drawer?.classList.add('open');
    backdrop?.classList.add('open');
    drawer?.setAttribute('aria-hidden', 'false');
    toggleBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };

  const closeDrawer = () => {
    drawer?.classList.remove('open');
    backdrop?.classList.remove('open');
    drawer?.setAttribute('aria-hidden', 'true');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  toggleBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('open')) closeDrawer();
  });
</script>

---
import { parishData } from '../data/parishData';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Top decorative cross and golden trim -->
  <div class="footer-top-accent">
    <div class="container footer-accent-inner">
      <div class="footer-cross-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2v20M5 8h14" stroke-linecap="round"/>
        </svg>
      </div>
      <p class="footer-motto">«{parishData.motto}»</p>
    </div>
  </div>

  <div class="container footer-main">
    <div class="footer-grid">
      <!-- Col 1: Parish Identity & Welcome -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <img src="/images/parish-crest.svg" alt="Escudo Parroquial" width="50" height="50" />
          <div>
            <h3 class="footer-title">{parishData.name}</h3>
            <span class="footer-diocese">{parishData.diocese}</span>
          </div>
        </div>
        <p class="footer-text">
          Comunidad católica viva y fraterna. Te invitamos a participar en nuestras celebraciones litúrgicas, grupos apostólicos y obras de servicio a los más necesitados.
        </p>
        <div class="social-links">
          <a href={parishData.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook Parroquial" class="social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
          <a href={parishData.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram Parroquial" class="social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href={parishData.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="Canal de YouTube" class="social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M21.58 7.19a2.5 2.5 0 00-1.76-1.77C18.26 5 12 5 12 5s-6.26 0-7.82.42A2.5 2.5 0 002.42 7.19 26.07 26.07 0 002 12a26.07 26.07 0 00.42 4.81 2.5 2.5 0 001.76 1.77C5.74 19 12 19 12 19s6.26 0 7.82-.42a2.5 2.5 0 001.76-1.77C22 16.81 22 12 22 12s0-4.81-.42-4.81zM9.75 15.02V8.98L15 12l-5.25 3.02z"/></svg>
          </a>
          <a href={`https://wa.me/${parishData.contact.whatsapp}?text=${encodeURIComponent(parishData.contact.whatsappMessage)}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Oficial" class="social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 1.742 1.97 2.08.188.043.332-.014.419-.101.087-.087.375-.434.476-.58.101-.145.202-.116.347-.058s.924.434 1.083.52c.159.087.26.13.299.202.043.072.043.419-.101.824z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-col">
        <h4 class="footer-col-title">Navegación</h4>
        <ul class="footer-links">
          <li><a href="/">Inicio</a></li>
          <li><a href="/nuestra-parroquia">Nuestra Parroquia</a></li>
          <li><a href="/pastorales">Grupos Pastorales</a></li>
          <li><a href="/experiencias">Experiencias y Galería</a></li>
          <li><a href="/contacto">Visítanos y Contacto</a></li>
          <li><a href="/contacto#guia-visitante">Guía para el Visitante</a></li>
        </ul>
      </div>

      <!-- Col 3: Mass Schedules -->
      <div class="footer-col">
        <h4 class="footer-col-title">Santas Misas</h4>
        <ul class="footer-schedule-list">
          <li>
            <strong>Lunes a Viernes:</strong>
            <span>7:00 am y 6:30 pm</span>
          </li>
          <li>
            <strong>Sábados (Vespertina):</strong>
            <span>6:30 pm</span>
          </li>
          <li>
            <strong>Domingos:</strong>
            <span>8:00 am, 10:00 am (Familias), 6:30 pm (Jóvenes)</span>
          </li>
          <li class="confession-highlight">
            <strong>Confesiones:</strong>
            <span>Media hora antes de cada Misa</span>
          </li>
        </ul>
      </div>

      <!-- Col 4: Contact & Office -->
      <div class="footer-col">
        <h4 class="footer-col-title">Despacho Parroquial</h4>
        <ul class="footer-contact-list">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{parishData.address.street}, {parishData.address.city}</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href={`tel:${parishData.contact.phone}`}>{parishData.contact.phoneDisplay}</a>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href={`mailto:${parishData.contact.email}`}>{parishData.contact.email}</a>
          </li>
          <li class="hours-item">
            <strong>Secretaría:</strong>
            <span>{parishData.contact.officeHours}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Copyright and Credo -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {currentYear} {parishData.fullName}. Todos los derechos reservados.</p>
      <p class="footer-note">Sede Digital Oficial • {parishData.diocese}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-green);
    color: #F5EFEB;
    margin-top: auto;
    border-top: 3px solid var(--color-gold);
  }

  .footer-top-accent {
    background-color: #172A25;
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(197, 160, 89, 0.2);
  }

  .footer-accent-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
  }

  .footer-cross-icon {
    color: var(--color-gold);
    display: flex;
    align-items: center;
  }

  .footer-motto {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-gold-light);
    font-size: 1.05rem;
    margin: 0;
  }

  .footer-main {
    padding: 4rem 1.5rem 3rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.3fr 1.4fr;
    gap: 3rem;
  }

  .brand-col .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.2rem;
  }

  .footer-title {
    color: #FFFFFF;
    font-size: 1.15rem;
    margin: 0;
  }

  .footer-diocese {
    color: var(--color-gold);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .footer-text {
    color: #D6CBC5;
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.08);
    color: #FAF5EE !important;
    transition: var(--transition-smooth);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .social-icon:hover {
    background-color: var(--color-burgundy);
    color: #FFFFFF !important;
    transform: translateY(-3px);
  }

  .footer-col-title {
    color: var(--color-gold-light);
    font-size: 1.1rem;
    margin-bottom: 1.4rem;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .footer-col-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 36px;
    height: 2px;
    background-color: var(--color-gold);
  }

  .footer-links, .footer-schedule-list, .footer-contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.9rem;
  }

  .footer-links a {
    color: #D6CBC5;
    transition: var(--transition-smooth);
  }

  .footer-links a:hover {
    color: var(--color-gold-light);
    padding-left: 4px;
  }

  .footer-schedule-list li {
    color: #E8DED8;
    line-height: 1.4;
  }

  .footer-schedule-list strong {
    color: #FFFFFF;
    display: block;
    margin-bottom: 0.15rem;
  }

  .confession-highlight {
    background: rgba(197, 160, 89, 0.1);
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--color-gold);
    margin-top: 0.4rem;
  }

  .footer-contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: #D6CBC5;
  }

  .footer-contact-list svg {
    color: var(--color-gold);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .footer-contact-list a {
    color: #FAF5EE;
  }

  .footer-contact-list a:hover {
    color: var(--color-gold);
  }

  .hours-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.4rem;
    padding-top: 0.5rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.15);
  }

  .footer-bottom {
    background-color: #12211D;
    padding: 1.5rem 0;
    font-size: 0.82rem;
    color: #A99E98;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
    }
    .footer-motto {
      font-size: 0.95rem;
    }
  }
</style>
